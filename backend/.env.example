DB_URL=sqlite+aiosqlite:///./dev.db
JWT_SECRET=please-change-me-to-a-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:5173"]

# ---- 建表方式（里程碑 11）----
# 开发期 true（启动时自动建表）；生产 false，改由 alembic upgrade head 管理表结构
DB_AUTO_CREATE=true

# ---- 缓存（里程碑 11）----
# memory = 进程内（开发，仅单进程互斥）；redis = 跨进程/多副本共享
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
# 分布式调度锁持有时长（秒），需大于单轮抓取耗时
SCHEDULER_LOCK_TTL_SECONDS=600

# ---- 爬虫采集（里程碑 6）----
# 原始 HTML 落盘目录（相对 backend），库里只存相对路径；已被 .gitignore 排除
STORAGE_DIR=storage
# 开发期可设为 false 关掉落盘，省磁盘空间
SAVE_RAW_HTML=true
CRAWL_TIMEOUT_SECONDS=15
# 新增/编辑竞品时「校验网址可达」用的更短超时（逐个页面检测，别卡太久）
CHECK_URL_TIMEOUT_SECONDS=12
# 连续失败达到该次数自动停用该监控源
CRAWL_MAX_FAIL_COUNT=5

# ---- 浏览器渲染（SPA 页面兜底）----
# 关闭后所有页面只走 httpx；启用还需 `playwright install chromium` 下载内核
BROWSER_RENDER_ENABLED=true
BROWSER_TIMEOUT_SECONDS=20
# 渲染后等 SPA 拉数据的上限（秒）；长轮询站点等不到就继续
BROWSER_NETWORK_IDLE_SECONDS=5
# 渲染时屏蔽图片/字体/媒体（正文提取用不到，更快更省流量）
BROWSER_BLOCK_ASSETS=true

# ---- LLM 分析（里程碑 7）----
# 关闭时走规则 Mock，无需任何 Key 即可端到端跑通；配置 Key 后自动走真实模型
LLM_ENABLED=false
LLM_API_KEY=
# 任何 OpenAI 兼容端点均可（DeepSeek / 通义 / OpenAI ...）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
# 变化行数低于该值不生成事件，避免噪声
LLM_MIN_CHANGE_LINES=3

# ---- 任务调度（里程碑 10）----
# 默认开启进程内调度：按每个监控源自己的频率到期抓取，每周一自动生成周报
SCHEDULER_ENABLED=true
# 扫描间隔（秒）与单次最大抓取量
SCHEDULER_TICK_SECONDS=60
SCHEDULER_BATCH_LIMIT=20
# 同批相邻抓取之间的间隔（秒），温和错峰
SCHEDULER_JITTER_SECONDS=0.5
# 周报自动生成时间（服务器本地时间的星期与小时）
REPORT_CRON_DAY_OF_WEEK=mon
REPORT_CRON_HOUR=6

# ---- 通知推送（里程碑 10.2，可选）----
# 关闭时只把结果写进日志；开启后可选择 log（仅写日志）/ smtp（发邮件）
NOTIFY_ENABLED=false
NOTIFY_BACKEND=log
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
# 收件人，多个用英文逗号分隔；留空则发给自己
NOTIFY_RECIPIENTS=
