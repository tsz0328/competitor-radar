# docker-compose 环境变量（复制为 .env 后生效；不复制也能起，全用下面的默认值）
#
# ⚠️ 真正部署时务必改掉所有 change_me：
#    python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=acr_change_me_root
MYSQL_DATABASE=competitor_radar
MYSQL_USER=acr
MYSQL_PASSWORD=acr_change_me

# ---- 后端 ----
JWT_SECRET=change-me-in-production

# ---- 对外端口 ----
HTTP_PORT=8080
