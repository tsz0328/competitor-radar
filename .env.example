# docker-compose 环境变量（复制为 .env 后生效；MySQL 密码与 JWT 必须自行填写）
#
# ⚠️ 真正部署时务必改掉所有 change_me：
#    python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---- MySQL ----
# Compose 不再提供可启动弱默认；这三个变量未设置时 docker compose 会直接拒绝展开
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=competitor_radar
MYSQL_USER=acr
MYSQL_PASSWORD=

# ---- 后端 ----
JWT_SECRET=

# ---- 对外端口 ----
HTTP_PORT=8080
